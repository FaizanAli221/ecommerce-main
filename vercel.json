{
  "version": 2,
  "rewrites": [
    { "source": "/vendor", "destination": "/pages/vendor.html" },
    { "source": "/admin", "destination": "/pages/admin.html" },
    { "source": "/checkout", "destination": "/pages/checkout.html" },
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/register", "destination": "/pages/register.html" },
    { "source": "/orders", "destination": "/pages/orders.html" },
    { "source": "/product/(.*)", "destination": "/pages/product.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
